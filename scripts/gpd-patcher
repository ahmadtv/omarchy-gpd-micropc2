#!/bin/bash
# gpd-patcher — apply/remove the GPD MicroPC 2 Omarchy patches, one at a time.
# Nothing is applied without asking, and every patch backs up what it replaces.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIGS="$REPO_ROOT/configs"
BEGIN_MARK="-- >>> gpd-micropc2-omarchy: %s (managed block, do not edit by hand) >>>"
END_MARK="-- <<< gpd-micropc2-omarchy: %s <<<"

ALL_PATCHES=(display bootmenu greeter scroll screensaver audio)
OPTIONAL_PATCHES=(denoise)

log()  { printf '  %s\n' "$*"; }
ok()   { printf '  \033[32m✔\033[0m %s\n' "$*"; }
skip() { printf '  \033[33m·\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✘\033[0m %s\n' "$*" >&2; }

# Back up a file the first time this script ever touches it. Safe to call
# repeatedly — it never overwrites the pristine original it already saved.
backup_once() {
  local target="$1" backup="$1.bak-gpd-patcher-original"
  [[ -e "$target" && ! -e "$backup" ]] && cp -a "$target" "$backup"
}

sudo_backup_once() {
  local target="$1" backup="$1.bak-gpd-patcher-original"
  [[ -e "$target" && ! -e "$backup" ]] && sudo cp -a "$target" "$backup"
}

append_block_once() {
  local file="$1" name="$2" content="$3"
  local begin end
  printf -v begin -- "$BEGIN_MARK" "$name"
  printf -v end -- "$END_MARK" "$name"
  mkdir -p "$(dirname "$file")"
  touch "$file"
  if grep -qF "$begin" "$file" 2>/dev/null; then
    return 1
  fi
  backup_once "$file"
  { printf '\n%s\n' "$begin"; printf '%s\n' "$content"; printf '%s\n' "$end"; } >> "$file"
  return 0
}

remove_block() {
  local file="$1" name="$2"
  local begin end
  printf -v begin -- "$BEGIN_MARK" "$name"
  printf -v end -- "$END_MARK" "$name"
  [[ -f "$file" ]] || return 1
  grep -qF "$begin" "$file" || return 1
  awk -v b="$begin" -v e="$end" 'index($0,b)==1{skip=1} !skip{print} index($0,e)==1{skip=0}' "$file" > "$file.tmp" && mv "$file.tmp" "$file"
  return 0
}

is_applied_display()    { grep -qF "GPD MicroPC 2's built-in panel" ~/.config/hypr/monitors.lua 2>/dev/null && [[ -f /etc/limine-entry-tool.d/display-rotation.conf ]]; }
is_applied_bootmenu()   { sudo grep -qE '^\s*interface_rotation:\s*90\s*$' /boot/limine.conf 2>/dev/null; }
is_applied_greeter()    { [[ -f /etc/sddm/hyprland.lua && -f /etc/sddm.conf.d/10-wayland.conf ]]; }
is_applied_scroll()     { grep -qF "gpd-micropc2-omarchy: scroll" ~/.config/hypr/input.lua 2>/dev/null || grep -qF 'touchdevice' ~/.config/hypr/input.lua 2>/dev/null; }
is_applied_screensaver(){ [[ -f ~/.config/foot/screensaver.ini && -x ~/.local/bin/omarchy-launch-screensaver ]]; }
is_applied_audio()      { local v; v=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@ 2>/dev/null | awk '{print $2}'); [[ -n "$v" ]] && awk -v v="$v" 'BEGIN{exit !(v <= 0.40)}'; }
is_applied_denoise()    { [[ -f ~/.config/pipewire/filter-chain.conf.d/source-rnnoise.conf ]] && systemctl --user is-active --quiet filter-chain.service && [[ "$(pactl get-default-source 2>/dev/null)" == "effect_output.rnnoise" ]]; }

apply_display() {
  backup_once ~/.config/hypr/monitors.lua
  cp "$CONFIGS/hypr/monitors.lua" ~/.config/hypr/monitors.lua
  ok "wrote ~/.config/hypr/monitors.lua (rotated DSI-1 landscape, scale 1.6)"

  sudo mkdir -p /etc/limine-entry-tool.d
  sudo_backup_once /etc/limine-entry-tool.d/display-rotation.conf
  sudo cp "$CONFIGS/limine/display-rotation.conf" /etc/limine-entry-tool.d/display-rotation.conf
  ok "wrote /etc/limine-entry-tool.d/display-rotation.conf"

  sudo limine-update
  ok "ran limine-update — verify with: sudo bootctl status --no-pager"

  hyprctl reload >/dev/null 2>&1
  hyprctl configerrors 2>/dev/null | grep -v '^$' && err "hyprctl reported config errors, check above" || ok "hyprctl reload clean"
}

remove_display() {
  [[ -f ~/.config/hypr/monitors.lua.bak-gpd-patcher-original ]] && cp -a ~/.config/hypr/monitors.lua.bak-gpd-patcher-original ~/.config/hypr/monitors.lua && ok "restored original monitors.lua"
  [[ -f /etc/limine-entry-tool.d/display-rotation.conf.bak-gpd-patcher-original ]] \
    && sudo cp -a /etc/limine-entry-tool.d/display-rotation.conf.bak-gpd-patcher-original /etc/limine-entry-tool.d/display-rotation.conf \
    || sudo rm -f /etc/limine-entry-tool.d/display-rotation.conf
  sudo limine-update
  ok "removed display-rotation patch and re-ran limine-update"
}

apply_bootmenu() {
  sudo test -f /boot/limine.conf || { err "/boot/limine.conf not found"; return 1; }
  sudo_backup_once /boot/limine.conf
  if ! sudo grep -qE '^\s*interface_rotation:' /boot/limine.conf; then
    sudo sed -i '1i interface_rotation: 90' /boot/limine.conf
  else
    sudo sed -i 's/^\s*interface_rotation:.*/interface_rotation: 90/' /boot/limine.conf
  fi
  sudo limine-update
  ok "set interface_rotation: 90 in /boot/limine.conf and ran limine-update"
}

remove_bootmenu() {
  [[ -f /boot/limine.conf.bak-gpd-patcher-original ]] && sudo cp -a /boot/limine.conf.bak-gpd-patcher-original /boot/limine.conf
  sudo limine-update
  ok "restored original /boot/limine.conf"
}

apply_greeter() {
  sudo mkdir -p /etc/sddm /etc/sddm.conf.d
  sudo_backup_once /etc/sddm/hyprland.lua
  sudo_backup_once /etc/sddm.conf.d/10-wayland.conf
  sudo cp "$CONFIGS/hypr/sddm-hyprland.lua" /etc/sddm/hyprland.lua
  sudo cp "$CONFIGS/sddm/10-wayland.conf" /etc/sddm.conf.d/10-wayland.conf
  ok "wrote SDDM greeter Hyprland config + Wayland compositor override"
  if command -v Hyprland >/dev/null; then
    Hyprland --verify-config --config /etc/sddm/hyprland.lua && ok "greeter config verifies ok" || err "greeter config failed verification"
  fi
  log "takes effect on next logout (restarting sddm now would end your session)"
}

remove_greeter() {
  [[ -f /etc/sddm/hyprland.lua.bak-gpd-patcher-original ]] && sudo cp -a /etc/sddm/hyprland.lua.bak-gpd-patcher-original /etc/sddm/hyprland.lua || sudo rm -f /etc/sddm/hyprland.lua
  [[ -f /etc/sddm.conf.d/10-wayland.conf.bak-gpd-patcher-original ]] && sudo cp -a /etc/sddm.conf.d/10-wayland.conf.bak-gpd-patcher-original /etc/sddm.conf.d/10-wayland.conf || sudo rm -f /etc/sddm.conf.d/10-wayland.conf
  ok "restored SDDM greeter config"
}

apply_scroll() {
  if is_applied_scroll; then skip "scroll settings already present in input.lua"; return; fi
  local content
  content=$(cat <<'LUA'
hl.config({
  input = {
    natural_scroll = true,
    touchpad = {
      natural_scroll = true,
    },
    -- Match the portrait-native touchscreen to the rotated internal display.
    touchdevice = {
      output = "DSI-1",
      transform = 3,
    },
  },
})
LUA
)
  if append_block_once ~/.config/hypr/input.lua scroll "$content"; then
    ok "added natural-scroll + touchscreen transform block to ~/.config/hypr/input.lua"
    hyprctl reload >/dev/null 2>&1
  else
    skip "scroll block already present in ~/.config/hypr/input.lua"
  fi
}

remove_scroll() {
  remove_block ~/.config/hypr/input.lua scroll && ok "removed scroll block from input.lua" || skip "no scroll block found"
  hyprctl reload >/dev/null 2>&1
}

apply_screensaver() {
  mkdir -p ~/.config/foot ~/.local/bin
  backup_once ~/.config/foot/screensaver.ini
  cp "$CONFIGS/foot/screensaver.ini" ~/.config/foot/screensaver.ini
  backup_once ~/.local/bin/omarchy-launch-screensaver
  cp "$CONFIGS/bin/omarchy-launch-screensaver" ~/.local/bin/omarchy-launch-screensaver
  chmod +x ~/.local/bin/omarchy-launch-screensaver
  ok "installed 8pt screensaver font + user launcher"

  local content='local user_bin = (os.getenv("HOME") or "") .. "/.local/bin"
hl.env("PATH", user_bin .. ":" .. (os.getenv("PATH") or "/usr/local/bin:/usr/bin"))'
  if append_block_once ~/.config/hypr/hyprland.lua screensaver "$content"; then
    ok "added user-bin PATH override to ~/.config/hypr/hyprland.lua"
    hyprctl reload >/dev/null 2>&1
    command -v omarchy >/dev/null && omarchy restart shell >/dev/null 2>&1
  else
    skip "PATH override already present in hyprland.lua"
  fi
}

remove_screensaver() {
  [[ -f ~/.config/foot/screensaver.ini.bak-gpd-patcher-original ]] && cp -a ~/.config/foot/screensaver.ini.bak-gpd-patcher-original ~/.config/foot/screensaver.ini || rm -f ~/.config/foot/screensaver.ini
  rm -f ~/.local/bin/omarchy-launch-screensaver
  remove_block ~/.config/hypr/hyprland.lua screensaver
  hyprctl reload >/dev/null 2>&1
  ok "removed screensaver font override and launcher"
}

apply_audio() {
  # Internal-mic clipping came from stacking full ALSA Capture gain on top of
  # full hardware Mic Boost. This single PipeWire route volume drives both
  # through a cubic curve — 0.35 lands at 100% Capture / 0% Boost, the
  # loudest clean gain before the boost stage (the actual clipper) engages.
  # This is the whole fix: no software processing, just a sane gain point.
  wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 0.35
  ok "set internal mic gain to a non-clipping level (0% hardware boost)"
}

remove_audio() {
  log "no file changes to undo — this patch only sets a PipeWire volume."
  log "raise it back yourself if you want to, e.g.: wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 0.70 (will clip)"
}

apply_denoise() {
  # Optional: a real-time neural denoiser on top of the (already clean, once
  # `audio` is applied) mic signal. This changes the tone of your voice —
  # some people prefer it for calls in noisy rooms, some find it thins the
  # sound out. Off by default; not included in `--apply all`.
  if ! pacman -Qq noise-suppression-for-voice >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm noise-suppression-for-voice
  fi
  ok "noise-suppression-for-voice (RNNoise LADSPA) installed"

  mkdir -p ~/.config/pipewire/filter-chain.conf.d
  cp "$CONFIGS/pipewire/source-rnnoise.conf" ~/.config/pipewire/filter-chain.conf.d/source-rnnoise.conf
  systemctl --user enable --now filter-chain.service >/dev/null
  sleep 1
  pactl set-default-source effect_output.rnnoise 2>/dev/null
  ok "denoised 'Microphone (Denoised)' source is now default input"
  log "not for everyone — remove any time with: gpd-patcher --remove denoise"
}

remove_denoise() {
  rm -f ~/.config/pipewire/filter-chain.conf.d/source-rnnoise.conf
  systemctl --user disable --now filter-chain.service >/dev/null 2>&1
  pactl set-default-source alsa_input.pci-0000_00_1f.3.analog-stereo 2>/dev/null
  ok "back to the plain gain-corrected mic, no denoising"
}

fix_touchscreen() {
  local dev="i2c-ILTP7807:00"
  if ! journalctl -b -k 2>/dev/null | grep -qi ILTP7807; then
    skip "no ILTP7807 touchscreen resume errors found in this boot's log"
  fi
  sudo sh -c "printf %s $dev > /sys/bus/i2c/drivers/i2c_hid_acpi/unbind" \
    && sudo sh -c "printf %s $dev > /sys/bus/i2c/drivers/i2c_hid_acpi/bind" \
    && ok "rebound the touchscreen driver" \
    || err "rebind failed — check dmesg"
  log "this is a recovery, not a fix; BIOS 2.17+ is reported to resolve it upstream"
}

usage() {
  cat <<EOF
gpd-patcher — GPD MicroPC 2 / Omarchy patches

Usage:
  gpd-patcher                 show status of every patch
  gpd-patcher --apply <name...|all>
  gpd-patcher --remove <name...|all>
  gpd-patcher --fix touchscreen   recover a dead touchscreen after sleep, no reboot

Patches: ${ALL_PATCHES[*]}  (included in --apply all)
  display      rotate the internal DSI-1 panel to landscape (Hyprland + kernel cmdline)
  bootmenu     rotate the Limine boot menu itself
  greeter      rotate the SDDM login/lock greeter to match
  scroll       natural scrolling + touchscreen transform
  screensaver  fit the stock screensaver on the 7" panel
  audio        fix internal-mic clipping (gain only, no processing)

Optional (NOT included in --apply all — changes the tone of your voice):
  denoise      real-time RNNoise filter on top of the audio patch
EOF
}

status() {
  echo "GPD MicroPC 2 patch status:"
  for p in "${ALL_PATCHES[@]}"; do
    if "is_applied_$p" 2>/dev/null; then ok "$p"; else skip "$p (not applied)"; fi
  done
  for p in "${OPTIONAL_PATCHES[@]}"; do
    if "is_applied_$p" 2>/dev/null; then ok "$p (optional)"; else skip "$p (optional, not applied)"; fi
  done
}

main() {
  local mode="${1:-}"
  case "$mode" in
    ""|--status) status ;;
    --fix)
      shift
      [[ "${1:-}" == "touchscreen" ]] && fix_touchscreen || { usage; exit 1; }
      ;;
    --apply|--remove)
      shift
      local names=("$@")
      [[ "${names[0]:-}" == "all" ]] && names=("${ALL_PATCHES[@]}")
      [[ ${#names[@]} -eq 0 ]] && { usage; exit 1; }
      for n in "${names[@]}"; do
        if [[ ! " ${ALL_PATCHES[*]} ${OPTIONAL_PATCHES[*]} " =~ " $n " ]]; then err "unknown patch: $n"; continue; fi
        echo "→ ${mode#--} $n"
        if [[ "$mode" == "--apply" ]]; then "apply_$n"; else "remove_$n"; fi
      done
      ;;
    -h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
